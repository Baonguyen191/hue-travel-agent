# Python
__pycache__/
*.py[cod]
.pytest_cache/
.venv/

# Environment and tooling
.env
.env.*
!.env.example
.coverage
htmlcov/

# Node
frontend/node_modules/
frontend/dist/
frontend/e2e/.results/

# Local editor files
.vscode/
.idea/

# Data (source DB supplied out of band; runtime state DB is local only)
data/*.sqlite
backend/data/*.sqlite
pytest-cache-files-*/
backend/data/*.bak
backend/data/*.sqlite-wal
backend/data/*.sqlite-shm
backend/data/*.sqlite-journal
backend/data/photo_cache/

# Evaluation run logs (console captures, never committed)
reports/understanding/*.log

# Guide corpus working file: candidate Wikipedia titles from build_guide_corpus.py --propose
backend/scripts/guide_proposals.json

# Photo working file: candidate Commons titles from build_photo_fallbacks proposals
backend/scripts/photo_proposals.json
