# Copy to .env (git-ignored). Empty values use the defaults shown in the comments.

# OpenAI key for the optional LLM fallback in the request parser; empty = rules only.
OPENAI_API_KEY=
# State DB (plans, approvals, bookings) URL; empty = backend/data/travel_state.sqlite (Docker sets Postgres).
DATABASE_URL=
# LangGraph checkpoint target; empty = backend/data/checkpoints.sqlite (Docker sets Postgres).
CHECKPOINT_URL=
# Read-only Hue POI SQLite file; empty = backend/data/hue.sqlite.
HUE_SQLITE_PATH=
# Postgres user for the compose stack; empty = travel.
POSTGRES_USER=
# Postgres password for the compose stack; empty = travel. Change it for anything beyond local development.
POSTGRES_PASSWORD=
# Postgres database name for the compose stack; empty = travel.
POSTGRES_DB=
